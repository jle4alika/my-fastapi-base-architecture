# Скопируйте в .env (в этой же папке) и подправьте значения.

# --- API / окружение ---
API_PORT=8000
API_WORKERS=2
NGINX_PORT=80
ENVIRONMENT=development
LOG_LEVEL=INFO
# За nginx выставьте true, чтобы rate limit брал IP из X-Forwarded-For
TRUST_PROXY_HEADERS=false

# JWT / fastapi-users (в production обязателен свой секрет!)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_SECRET
JWT_ACCESS_EXPIRE_MINUTES=30

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=fastapi_architecture
DB_USE_PGBOUNCER=false
# DB_TEST_URL=
# DB_DIRECT_HOST=
# DB_DIRECT_PORT=
# DB_MIGRATE_ON_STARTUP=false
# DB_CREATE_ALL_ON_STARTUP=false

# PgBouncer / прямой Postgres (docker)
PB_MAX_CLIENTS=100
PB_DEFAULT_POOL_SIZE=10
PB_POOL_MODE=transaction
PGBOUNCER_PORT=6432
POSTGRES_PUBLISHED_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_OPTIONAL=true
REDIS_GUI_PORT=5540

# --- Cache (fastapi-cache2) ---
CACHE_NAMESPACE_ME=me
CACHE_NAMESPACE_USER=get-user
CACHE_EXPIRE_SECONDS=60

# --- SMTP (reset/verify email) ---
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=30

# --- RabbitMQ ---
RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_MANAGEMENT_PORT=15672
RMQ_LOGIN=guest
RMQ_PASS=guest

# --- Celery (опционально) ---
# Раскомментируй, чтобы поднять worker + celery-exporter вместе со стеком:
# COMPOSE_PROFILES=celery
# Либо: make up-dev-celery / make up-prod-celery
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_DEFAULT_QUEUE=celery

# --- Monitoring (доступ через nginx: /grafana/) ---
# GRAFANA_ROOT_URL=http://localhost/grafana/
# GRAFANA_DOMAIN=localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
