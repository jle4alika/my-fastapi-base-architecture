# Database — в Docker приложения ходят через pgbouncer (сервисный hostname)
DB_HOST=localhost
DB_PORT=6432
DB_USER=postgres
DB_PASS=mysecretpassword
DB_NAME=gloomth_messanger
DB_USE_PGBOUNCER=true

# PgBouncer
PB_MAX_CLIENTS=100
PB_DEFAULT_POOL_SIZE=10
PB_POOL_MODE=transaction
PGBOUNCER_PORT=6432
POSTGRES_PUBLISHED_PORT=5433

# API / nginx
API_PORT=8000
API_WORKERS=2
NGINX_PORT=80
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_SECRET

# RabbitMQ
RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_MANAGEMENT_PORT=15672
RMQ_LOGIN=guest
RMQ_PASS=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_OPTIONAL=true
REDIS_GUI_PORT=5540

# Celery
CELERY_WORKER_CONCURRENCY=2

# Monitoring (через http://localhost/grafana/)
GRAFANA_ROOT_URL=http://localhost/grafana/
GRAFANA_DOMAIN=localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
